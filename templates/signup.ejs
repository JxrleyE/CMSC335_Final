<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Sign Up </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="card">
        <p class="site-title">AnimeList</p>

        <h2> Sign Up </h2>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

        <form action="/signup" method="POST">
            <div>
                <label for="username"> Username: </label>
                <input id="username" name="username" value="<%= username %>" placeholder="Enter a username" required>
            </div>

            <div> 
                <label for="pw"> Password: </label>
                <input id="pw" name="pw" type="password" placeholder=" Enter a password" required>
            </div>
            <button> Sign Up </button>
        </form>

        <p class="subtext"> Already have an account? <a href="/"> Login!</a></p>
    </div>
    
</body>
</html>