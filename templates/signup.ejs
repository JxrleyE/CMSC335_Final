<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Sign Up </title>
</head>
<body>

    <div>
        <h2> Sign Up </h2>
            <% if (error) { %>
                <p style="color: red;"><%= error %></p>
            <% } %>
            <form action="/signup" method="POST">
                <label> Username: </label>
                <input id="username" name="username" value="<%= username %>" placeholder="Please enter a username" required>

                <label> Password: </label>
                <input id="pw" name="pw" placeholder="Please enter a password" required>

                <button> Sign Up </button>
            </form>

            <p> Already have an account? <a href="/"> Login!</a></p>
    </div>
    
</body>
</html>