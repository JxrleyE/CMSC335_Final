<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Login</title>
</head>
<body>

    <div>
        <h2> Login </h2>
            <% if (error) { %>
                <p style="color: red;"><%= error %></p>
            <% } %>
            <form action="/login" method="POST">
                <label> Username: </label>
                <input id="username" name="username" value="<%= username %>" placeholder="Please enter your username" required>

                <label> Password: </label>
                <input id="pw" name="pw" placeholder="Please enter your password" required>

                <button> Login </button>
            </form>

            <p> Dont have an account? <a href="/signup"> Sign Up!</a></p>
    </div>
    
</body>
</html>