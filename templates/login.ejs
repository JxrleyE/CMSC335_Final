<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Login </title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <div class="card">
        <p class="site-title">AnimeList</p>
        <h2>Welcome Back</h2>

        <% if (error) { %>
            <p class="error"><%= error %></p>
        <% } %>

        <form action="/login" method="POST">
            <div>
                <label for="username">Username</label>
                <input id="username" name="username" value="<%= username %>" placeholder="Enter your username" required>
            </div>
            <div>
                <label for="pw">Password</label>
                <input id="pw" name="pw" type="password" placeholder="Enter your password" required>
            </div>
            <button type="submit">Login</button>
        </form>

        <p class="subtext">Don't have an account? <a href="/signup">Sign Up!</a></p>
    </div>

</body>
</html>
